# WAHA production configuration
# Copy to .env on the server. Never commit the real .env or secrets.

TZ=Asia/Jakarta
WAHA_IMAGE=devlikeapro/waha
WAHA_CONTAINER_NAME=laporin-waha
WAHA_VOLUME_NAME=laporin-waha-sessions
WAHA_PORT=3001

# Public URL behind HTTPS reverse proxy
WAHA_BASE_URL=https://waha.assetloan.my.id

# WhatsApp engine
WHATSAPP_DEFAULT_ENGINE=NOWEB

# API authentication - generate a long random value
WAHA_API_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# Dashboard / Swagger credentials
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD
WHATSAPP_SWAGGER_ENABLED=true
WHATSAPP_SWAGGER_USERNAME=admin
WHATSAPP_SWAGGER_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD

# Logging
WAHA_LOG_FORMAT=JSON
WAHA_LOG_LEVEL=info
WAHA_HTTP_LOG_LEVEL=info

# Optional webhook to the Laravel application.
# Example: https://report.assetloan.my.id/api/waha/webhook
WHATSAPP_HOOK_URL=
WHATSAPP_HOOK_EVENTS=message,message.any,state.change
WHATSAPP_HOOK_HMAC_KEY=
