APP_NAME=LAPORIN
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Database Configuration
# DB_CONNECTION options: sqlite, mysql, mariadb, pgsql, sqlsrv
# For production, use mariadb or mysql with proper credentials
DB_CONNECTION=mysql
DB_HOST=laporin-db
DB_PORT=3306
DB_DATABASE=laporin
DB_USERNAME=laporin
DB_PASSWORD=[REDACTED]

# Encryption key must be set for encrypted casts (PII fields)
# Generate with: php artisan key:generate
APP_CIPHER=AES-256-CBC

SESSION_DRIVER=redis
SESSION_LIFETIME=120
CACHE_STORE=redis
CACHE_PREFIX=laporin_
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Session security configuration for HTTPS
# Set to true in production with HTTPS
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=strict

# Redis configuration
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_DB=0
REDIS_CACHE_DB=1

# Trusted proxies for reverse proxy (Cloudflare, etc.)
# Set to specific IP addresses in production, not *
TRUSTED_PROXIES=

# SMTP Gmail untuk notifikasi email laporan
# Ganti MAIL_PASSWORD dengan Google App Password atau kredensial SMTP yang valid.
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_TIMEOUT=5
MAIL_USERNAME=openclaaw@gmail.com
MAIL_PASSWORD=[GOOGLE_APP_PASSWORD]
MAIL_FROM_ADDRESS=openclaaw@gmail.com
MAIL_FROM_NAME="LAPORIN"
