APP_NAME=LAPORIN
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Database Configuration
DB_CONNECTION=mysql
DB_HOST=laporin-db
DB_PORT=3306
DB_DATABASE=laporin
DB_USERNAME=laporin
DB_PASSWORD=[REDACTED]

# Encryption key must be set for encrypted casts (PII fields)
APP_CIPHER=AES-256-CBC

# Cache / session
# Redis is preferred; failover keeps the application usable if Redis is temporarily unavailable.
SESSION_DRIVER=redis
SESSION_LIFETIME=120
CACHE_STORE=failover
CACHE_PREFIX=laporin_
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Session security configuration for HTTPS
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=strict

# Redis configuration
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_DB=0
REDIS_CACHE_DB=1

# Trusted proxies for reverse proxy (Cloudflare, etc.)
# Set to specific IP addresses in production, not *
TRUSTED_PROXIES=

# SMTP Gmail untuk notifikasi email laporan
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_TIMEOUT=5
MAIL_USERNAME=openclaaw@gmail.com
MAIL_PASSWORD=[GOOGLE_APP_PASSWORD]
MAIL_FROM_ADDRESS=openclaaw@gmail.com
MAIL_FROM_NAME="LAPORIN"

# WAHA - server-side WhatsApp API
# The API key is never exposed to frontend JavaScript or Blade templates.
WAHA_URL=https://waha.assetloan.my.id
WAHA_API_KEY=[WAHA_API_KEY]
WAHA_SESSION=default
