APP_NAME=LAPORIN
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Database Configuration
# DB_CONNECTION options: sqlite, mysql, mariadb, pgsql, sqlsrv
# For production, use mariadb or mysql with proper credentials
DB_CONNECTION=mysql
DB_HOST=laporin-db
DB_PORT=3306
DB_DATABASE=laporin
DB_USERNAME=laporin
DB_PASSWORD=[REDACTED]

# Encryption key must be set for encrypted casts (PII fields)
# Generate with: php artisan key:generate
APP_CIPHER=AES-256-CBC

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_CONNECTION=default
CACHE_STORE=redis
CACHE_PREFIX=laporin_local_cache_
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
SESSION_COOKIE=laporin_local_session

# Session security configuration for HTTPS
# Set to true in production with HTTPS
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Redis configuration
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=2
REDIS_CACHE_DB=3
REDIS_PREFIX=laporin_local_
REDIS_CACHE_CONNECTION=cache
REDIS_CACHE_LOCK_CONNECTION=default

# Trusted proxies for reverse proxy (Cloudflare, etc.)
# Keep empty for direct/local traffic. Set to the actual Cloudflared
# container IP or Docker network in production; never use *.
TRUSTED_PROXIES=

# SMTP Gmail untuk notifikasi email laporan
# Ganti MAIL_PASSWORD dengan Google App Password atau kredensial SMTP yang valid.
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=noreplylaporin@gmail.com
MAIL_PASSWORD=[GOOGLE_APP_PASSWORD]
MAIL_FROM_ADDRESS=noreplylaporin@gmail.com
MAIL_FROM_NAME="LAPORIN"

# Only for local/test database seeding; never set in production.
SEEDER_DEFAULT_PASSWORD=
