APP_NAME=LAPORIN
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=laporin-db
DB_PORT=3306
DB_DATABASE=laporin
DB_USERNAME=laporin
DB_PASSWORD=[REDACTED]

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# SMTP Gmail untuk notifikasi email laporan
# Ganti MAIL_PASSWORD dengan Google App Password atau kredensial SMTP yang valid.
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=openclaaw@gmail.com
MAIL_PASSWORD=[GOOGLE_APP_PASSWORD]
MAIL_FROM_ADDRESS=openclaaw@gmail.com
MAIL_FROM_NAME="LAPORIN"
