  "commandsReference": {
    "setupBranch": "git checkout -b feature/docs-restructuring-modular-12domain && git push -u origin feature/docs-restructuring-modular-12domain",
    "backup": "cp -r docs docs.backup-before-restructuring",
    "createFolders": "mkdir -p docs/{api,ui,ux,auth,database,testing,deployment,business,development,decisions,performance,archive}",
    "moveFile": "git mv docs/OLD_FILE.md docs/domain/new-file.md",
    "linkValidation": "markdown-link-check 'docs/**/*.md' || remark docs --use validate-links",
    "metadataVerification": "python3 .kiro/verify-metadata.py",
    "finalCommit": "git commit -F .kiro/commit-message.txt",
    "pushBranch": "git push origin feature/docs-restructuring-modular-12domain",
    "createPR": "gh pr create --title 'docs: restructure from flat to modular 12-domain architecture'"
  },
