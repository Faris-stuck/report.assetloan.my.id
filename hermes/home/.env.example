AI_AGENT_NAME=Hermes Agent
AI_AGENT_BASE_URL=https://ai.sumopod.com/v1
AI_AGENT_API_KEY=replace-with-real-key
AI_AGENT_MODEL=seed-2-0-pro
AI_AGENT_TEMPERATURE=0.12
AI_AGENT_MAX_TOKENS=900
AI_AGENT_TIMEOUT=45

AI_AGENT_MEMORY_ENABLED=true
AI_AGENT_MEMORY_STORAGE_DIR=hermes/data/memory
AI_AGENT_MEMORY_MAX_MESSAGES_PER_CONVERSATION=40
AI_AGENT_MEMORY_MAX_NOTES_PER_USER=30

AI_AGENT_SKILLS_ENABLED=true
AI_AGENT_SKILLS_STORAGE_DIR=hermes/skills
AI_AGENT_SKILLS_MAX_MATCHES=3
AI_AGENT_SKILLS_MAX_CHARS_PER_SKILL=1400

AI_AGENT_SELF_IMPROVEMENT_ENABLED=true
AI_AGENT_SELF_IMPROVEMENT_PATCHES_DIR=hermes/patches
AI_AGENT_SELF_IMPROVEMENT_LOGS_DIR=hermes/logs
