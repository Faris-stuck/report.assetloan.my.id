services:
  app:
    image: lapapp:20260821-lokasi
    container_name: app
    ports:
      - "127.0.0.1:18080:8080"
    env_file:
      - /etc/laporin/laporin-production.env
    volumes:
      - laporin-prod-storage:/var/www/html/storage/app
      # storage/logs sebelumnya hanya ada di writable layer container, sehingga
      # laravel.log terhapus setiap kali container dibuat ulang (setiap deploy).
      # Bukti kegagalan 500 pun ikut hilang justru saat paling dibutuhkan.
      - laporin-prod-logs:/var/www/html/storage/logs
    networks:
      cf-network:
        aliases:
          - app
    restart: unless-stopped

  # Tanpa service ini tidak ada apa pun yang menjalankan `schedule:run`, sehingga
  # `queue:prune-failed --hours=48` di routes/console.php belum pernah dieksekusi:
  # 10 baris failed_jobs menumpuk sejak 15 Agustus, padahal payload-nya memuat
  # kode akses laporan. Dipakai schedule:work (loop foreground) alih-alih cron
  # host supaya polanya sama dengan worker lain dan tidak bergantung pada crontab
  # di luar compose. HANYA BOLEH ADA SATU instance agar tugas tidak dobel.
  scheduler:
    image: lapapp:20260821-lokasi
    container_name: laporin-scheduler
    env_file:
      - /etc/laporin/laporin-production.env
    # Lihat catatan pada worker-notifications: config:cache runtime wajib lebih
    # dulu, kalau tidak scheduler memakai konfigurasi build-time.
    command: ["sh", "-lc", "php artisan config:cache && exec php artisan schedule:work --whisper"]
    healthcheck:
      test: ["CMD-SHELL", "pgrep -f 'artisan schedule:work' >/dev/null || exit 1"]
      interval: 30s
      timeout: 10s
      start_period: 15s
      retries: 3
    volumes:
      - laporin-prod-storage:/var/www/html/storage/app
      - laporin-prod-logs:/var/www/html/storage/logs
    networks:
      - cf-network
    restart: unless-stopped

  worker-notifications:
    image: lapapp:20260821-lokasi
    container_name: laporin-worker-notifications
    env_file:
      - /etc/laporin/laporin-production.env
    # config:cache wajib dibangun dari env runtime sebelum queue:work.
    # Tanpa ini worker memakai bootstrap/cache/config.php yang ter-bake saat image
    # build (Redis 127.0.0.1 tanpa password, mail=log, WAHA tanpa API key), sehingga
    # job notifikasi menumpuk di Redis dan tidak pernah terkirim.
    command: ["sh", "-lc", "php artisan config:cache && exec php artisan queue:work redis --queue=notifications --sleep=1 --tries=1 --timeout=60 --max-time=3600"]
    healthcheck:
      test: ["CMD-SHELL", "pgrep -f 'php artisan queue:work' >/dev/null || exit 1"]
      interval: 30s
      timeout: 10s
      start_period: 15s
      retries: 3
    volumes:
      - laporin-prod-storage:/var/www/html/storage/app
      - laporin-prod-logs:/var/www/html/storage/logs
    networks:
      - cf-network
    restart: unless-stopped

  worker-email:
    image: lapapp:20260821-lokasi
    container_name: laporin-worker-email
    env_file:
      - /etc/laporin/laporin-production.env
    # Lihat catatan pada worker-notifications: tanpa config:cache runtime, worker ini
    # memakai mail.default=log dari cache build-time sehingga email hanya ditulis ke log.
    command: ["sh", "-lc", "php artisan config:cache && exec php artisan queue:work redis --queue=email --sleep=1 --tries=3 --backoff=30 --timeout=120 --max-time=3600"]
    healthcheck:
      test: ["CMD-SHELL", "pgrep -f 'php artisan queue:work' >/dev/null || exit 1"]
      interval: 30s
      timeout: 10s
      start_period: 15s
      retries: 3
    volumes:
      - laporin-prod-storage:/var/www/html/storage/app
      - laporin-prod-logs:/var/www/html/storage/logs
    networks:
      - cf-network
    restart: unless-stopped

  # Redis dipindahkan ke file ini dari redis-production.compose.yml. Sebelumnya
  # dua file compose memakai nama project yang sama ("html"), sehingga setiap
  # `docker compose -f app-production.compose.yml ...` melaporkan laporin-redis
  # sebagai orphan DAN Docker sendiri menyarankan `--remove-orphans` — perintah
  # yang akan MENGHAPUS Redis tempat seluruh session, cache, dan queue disimpan.
  # Satu project = satu file supaya saran itu tidak lagi berbahaya.
  redis:
    image: redis:7-alpine
    container_name: laporin-redis
    # Hanya REDIS_PASSWORD, bukan seluruh env aplikasi. Sebelumnya container ini
    # ikut menerima APP_KEY, DB_PASSWORD, dan MAIL_PASSWORD lewat symlink
    # .laporin-production.env padahal tidak membutuhkannya sama sekali.
    env_file:
      - /etc/laporin/laporin-redis.env
    command:
      - sh
      - -lc
      - exec redis-server --appendonly yes --appendfsync everysec --requirepass "$$REDIS_PASSWORD" --maxmemory 256mb --maxmemory-policy allkeys-lru
    healthcheck:
      test: ["CMD-SHELL", "redis-cli -a \"$$REDIS_PASSWORD\" --no-auth-warning PING | grep -q PONG"]
      interval: 30s
      timeout: 10s
      start_period: 10s
      retries: 3
    volumes:
      - laporin-redis-data:/data
    networks:
      cf-network:
        aliases:
          - laporin-redis
          - redis
    ports:
      - "127.0.0.1:6380:6379"
    restart: unless-stopped

  worker-whatsapp:
    image: lapapp:20260821-lokasi
    container_name: laporin-worker-whatsapp
    env_file:
      - /etc/laporin/laporin-production.env
    # Lihat catatan pada worker-notifications: tanpa config:cache runtime, worker ini
    # memakai WAHA_API_KEY kosong dari cache build-time sehingga WahaService melempar
    # "WAHA is not configured" pada setiap job.
    command: ["sh", "-lc", "php artisan config:cache && exec php artisan queue:work redis --queue=whatsapp --sleep=1 --tries=3 --backoff=30 --timeout=120 --max-time=3600"]
    healthcheck:
      test: ["CMD-SHELL", "pgrep -f 'php artisan queue:work' >/dev/null || exit 1"]
      interval: 30s
      timeout: 10s
      start_period: 15s
      retries: 3
    volumes:
      - laporin-prod-storage:/var/www/html/storage/app
      - laporin-prod-logs:/var/www/html/storage/logs
    networks:
      - cf-network
    restart: unless-stopped

volumes:
  laporin-prod-storage:
    external: true
  laporin-prod-logs:
    external: true
  laporin-redis-data:
    external: true

networks:
  cf-network:
    external: true
